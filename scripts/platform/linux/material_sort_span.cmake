# ---------------------------------------------------------------------------
# The Material_Sort span of src/gfx_d3d/r_material_load_obj.cpp
#
# r_material_load_obj.cpp does not compile on Linux (d3dx9, Win32 file APIs),
# but its tail -- Material_Sort and the comparison helpers it uses -- is plain
# engine code every renderer needs once materials are registered. This copies
# that span verbatim into a generated unit, checks that it still defines what the
# Linux targets use and gained no #include, and sets KISAK_MATERIAL_SORT_SPAN_UNIT
# to the generated file. Used by the world front-end probe and KisakCOD-mp.
# ---------------------------------------------------------------------------
include_guard(GLOBAL)
set(material_span_material_source "${SRC_DIR}/gfx_d3d/r_material_load_obj.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${material_span_material_source}")
file(READ "${material_span_material_source}" material_span_material_text)
# Engine sources are dropping the redundant __cdecl (upstream issue 35), so the
# marker and the required definitions match with or without it. The generated
# unit still copies the span verbatim.
set(material_span_material_marker "void Material_GetVertexShaderName(")
string(FIND "${material_span_material_text}" "\nvoid __cdecl Material_GetVertexShaderName(" material_span_cdecl_marker_at)
if(NOT material_span_cdecl_marker_at EQUAL -1)
    set(material_span_material_marker "void __cdecl Material_GetVertexShaderName(")
endif()
string(FIND "${material_span_material_text}" "\n${material_span_material_marker}" material_span_marker_at)
string(FIND "${material_span_material_text}" "\n${material_span_material_marker}" material_span_marker_last REVERSE)
if(material_span_marker_at EQUAL -1 OR NOT material_span_marker_at EQUAL material_span_marker_last)
    message(FATAL_ERROR "r_material_load_obj.cpp must define '${material_span_material_marker}' exactly once at the start of a line")
endif()
math(EXPR material_span_span_at "${material_span_marker_at} + 1")
string(SUBSTRING "${material_span_material_text}" 0 ${material_span_span_at} material_span_material_head)
string(SUBSTRING "${material_span_material_text}" ${material_span_span_at} -1 material_span_material_span)
string(REGEX MATCHALL "\n" material_span_head_lines "${material_span_material_head}")
list(LENGTH material_span_head_lines material_span_span_line)
math(EXPR material_span_span_line "${material_span_span_line} + 1")
string(REPLACE "__cdecl " "" material_span_material_span_plain "${material_span_material_span}")
foreach(required_definition
        "void Material_SortInternal(Material **sortedMaterials, uint32_t materialCount)"
        "void Material_Sort()"
        "bool Material_Compare(const Material *mtl0, const Material *mtl1)")
    string(FIND "${material_span_material_span_plain}" "${required_definition}" required_at)
    if(required_at EQUAL -1)
        message(FATAL_ERROR "the Material_Sort span of r_material_load_obj.cpp no longer defines '${required_definition}'")
    endif()
endforeach()
string(FIND "${material_span_material_span}" "#include" material_span_span_include)
if(NOT material_span_span_include EQUAL -1)
    message(FATAL_ERROR "the Material_Sort span of r_material_load_obj.cpp gained an #include; review the generated unit")
endif()
set(material_span_material_unit "${CMAKE_BINARY_DIR}/linux_generated/material_sort_span.cpp")
set(material_span_material_unit_text
"// Generated by scripts/platform/linux/material_sort_span.cmake. Do not edit.
// Lines ${material_span_span_line}-end of src/gfx_d3d/r_material_load_obj.cpp, copied
// verbatim: Material_Sort and the comparison helpers it uses. The rest of that
// file does not compile on Linux (d3dx9, Win32 file APIs).
#include <universal/q_shared.h>
#include <gfx_d3d/r_material.h>
#include <gfx_d3d/r_utils.h>
#include <gfx_d3d/r_init.h>
#include <database/database.h>
#include <algorithm>
#include <cstring>
#line ${material_span_span_line} \"src/gfx_d3d/r_material_load_obj.cpp\"
${material_span_material_span}")
set(material_span_material_unit_old "")
if(EXISTS "${material_span_material_unit}")
    file(READ "${material_span_material_unit}" material_span_material_unit_old)
endif()
if(NOT material_span_material_unit_old STREQUAL material_span_material_unit_text)
    file(WRITE "${material_span_material_unit}" "${material_span_material_unit_text}")
endif()
message(STATUS "Material_Sort span from r_material_load_obj.cpp line ${material_span_span_line}")
set(KISAK_MATERIAL_SORT_SPAN_UNIT "${material_span_material_unit}")
