From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: koalabuttz <27229333+koalabuttz@users.noreply.github.com>
Date: Tue, 10 Nov 2026 04:15:32 +0000
Subject: [PATCH] security: refuse rcon when rcon_password is unset

SVC_RemoteCommand tested rcon_password->current.integer, which for a
string dvar is the string pointer and never zero. With no password set,
`rcon "" <command>` from any address matched the empty string and ran.

Test the first character of the string instead.
---
 src/server_mp/sv_main_pc_mp.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/server_mp/sv_main_pc_mp.cpp b/src/server_mp/sv_main_pc_mp.cpp
index 48907423..d179cdc1 100644
--- a/src/server_mp/sv_main_pc_mp.cpp
+++ b/src/server_mp/sv_main_pc_mp.cpp
@@ -258,7 +258,7 @@ void __cdecl SVC_RemoteCommand(netadr_t from)
     {
         lasttime = time;
         password = SV_Cmd_Argv(1);
-        if (rcon_password->current.integer && !strcmp(password, rcon_password->current.string))
+        if (rcon_password->current.string[0] && !strcmp(password, rcon_password->current.string))
         {
             valid = 1;
             v6 = SV_Cmd_Argv(2);
@@ -274,7 +274,7 @@ void __cdecl SVC_RemoteCommand(netadr_t from)
         }
         svs.redirectAddress = from;
         Com_BeginRedirect(sv_outputbuf, 0x7F0u, SV_FlushRedirect);
-        if (rcon_password->current.integer)
+        if (rcon_password->current.string[0])
         {
             if (valid)
             {
