 src/sound/snd.cpp                   |  2 +-
 src/win32/win_configure.cpp         |  9 +++++----
 src/win32/win_steam.cpp             |  2 +-
 src/win32/win_syscon.cpp            | 11 +++++++----
 src/win32/win_voice.cpp             |  2 +-
 11 files changed, 37 insertions(+), 31 deletions(-)

