index 4751d9a3..ab24f2b7 100644
--- a/src/universal/com_math.h
+++ b/src/universal/com_math.h
@@ -204,6 +204,15 @@ inline constexpr double TURNS_PER_DEGREE = 0.002777777845039964;
 static_assert(TURNS_PER_DEGREE_F == 0.0027777778f && TURNS_PER_DEGREE_F == (float)0.0027777778);
 static_assert(TURNS_PER_DEGREE_F == 0.002777777845039964f && (float)TURNS_PER_DEGREE == TURNS_PER_DEGREE_F);
 
+// Wraps an angle in degrees into [-180, 180] by taking off the nearest whole
+// turn. This is the wrap the game code inlines; AngleNormalize180() uses fmodf
+// and rounds differently.
+inline float AngleWrap180(float angle)
+{
+    const float turns = angle * TURNS_PER_DEGREE_F;
+    return (turns - floorf(turns + 0.5f)) * 360.0f;
+}
+
 // A 16-bit angle splits a turn into 65536 steps. The _F constants are floats,
 // the plain ones doubles, so each use keeps the type it multiplied by.
 // SHORTS_PER_DEGREE is the float factor as the code has always written it in
