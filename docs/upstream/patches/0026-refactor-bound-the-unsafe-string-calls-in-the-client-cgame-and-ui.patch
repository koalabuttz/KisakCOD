 src/ui/ui_shared.cpp            |   2 +-
 src/ui/ui_shared_obj.cpp        |  82 ++++++++----------------
 src/ui_mp/ui_main_mp.cpp        |  18 ++----
 12 files changed, 98 insertions(+), 165 deletions(-)

